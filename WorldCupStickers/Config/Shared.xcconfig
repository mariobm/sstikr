// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = WorldCupStickers
PRODUCT_DISPLAY_NAME = Sstikr
PRODUCT_BUNDLE_IDENTIFIER = com.sstikr.worldcupstickers
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM = RJS3R23FND

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist

// ==========================================
// Backend Configuration
// ==========================================
// Keep these empty in git unless you explicitly want a public client config baked into the app build.
SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =
SUPABASE_REDIRECT_URL =

// The public Cloudflare relay owns the sports provider token and APNs secrets.
GOAL_RELAY_URL = https:/$()/sstikr-goal-relay.mario-balukcic1.workers.dev

// Local.xcconfig is git-ignored and can provide the public Supabase client values for device builds.
#include? "Local.xcconfig"

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/WorldCupStickers.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/WorldCupStickers.entitlements
